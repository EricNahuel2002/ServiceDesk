# Copia este archivo como .env y ajusta los valores.
# .env NO se versiona; contiene secretos locales.

# Requeridas
SA_PASSWORD=Cambia_esta_contrasena_fuerte_2026!
JWT_SECRET=Cambia_esta_clave_JWT_con_al_menos_32_caracteres

# Opcionales (puertos publicados en el host)
# SQL_PORT=14333
# API_PORT=5216
# FRONTEND_PORT=5173
# AZURITE_BLOB_PORT=10000
# AZURITE_QUEUE_PORT=10001
# AZURITE_TABLE_PORT=10002

# Azure Communication Services (opcional)
# Habilita el envio de emails reales desde las Azure Functions localmente.
# ACS_ENABLED=false
# ACS_CONNECTION_STRING=endpoint=<endpoint>;accesskey=<accesskey>
# ACS_SENDER_ADDRESS=DoNotReply@<guid>.azurecomm.net
# ACS_SENDER_DISPLAY_NAME=ServiceDesk